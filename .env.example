DATABASE_URL=postgres://chum_mem:chum_mem@postgres:5432/chum_mem
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=25
DB_CONNECT_TIMEOUT_SECS=15
DB_ACQUIRE_TIMEOUT_SECS=15
RUN_DB_MIGRATIONS=true
READINESS_TIMEOUT_MS=5000
API_NODE_OPTIONS=--max-old-space-size=512
WORKER_NODE_OPTIONS=--max-old-space-size=640
MCP_HOST=0.0.0.0
MCP_PORT=63001
WEB_PORT=63000
DASHBOARD_API_URL=http://api:63001
KNOWLEDGE_GRAPH_MAX_CLUSTER_NODES=8000
KNOWLEDGE_GRAPH_MAX_CLUSTER_EDGES=20000
VECTOR_STORE_BACKEND=turbovec
CHROMA_COLLECTION=memories
TURBOVEC_PATH=/data/turbovec
TURBOVEC_BIT_WIDTH=4
CHUM_MEM_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
CHUM_MEM_TEAM_ID=00000000-0000-0000-0000-000000000002
CHUM_MEM_USER_ID=00000000-0000-0000-0000-000000000004
CHUM_MEM_ACTOR_TYPE=system
CHUM_MEM_TEAM_ROLE=admin
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=1
POSTGRES_DB=chum_mem
POSTGRES_USER=chum_mem
POSTGRES_PASSWORD=chum_mem
# Shared API tokens (comma-separated). The API refuses to start while this is
# empty unless CHUM_MEM_ALLOW_NO_AUTH=1 (laptop-only stacks). deploy/gcp/startup.sh
# generates it on a VM's first boot.
CHUM_MEM_API_TOKENS=
# Admin tokens (comma-separated) for /api/admin/*, /v1/ingest/bulk/*, claim
# governance and full repository replaces. Keep them off laptops.
CHUM_MEM_ADMIN_TOKENS=
# Set to 1 ONLY for a stack that nothing but this machine can reach.
CHUM_MEM_ALLOW_NO_AUTH=
# Token the dashboard uses to call the API (one of the above)
CHUM_MEMORY_API_TOKEN=
